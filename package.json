{
  "name": "mistral-hack-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter cfca-api dev",
    "dev:web": "pnpm --filter web dev",
    "migrate:api": "pnpm --filter cfca-api migrate",
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint"
  }
}
